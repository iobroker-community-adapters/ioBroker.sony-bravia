{
  "name": "iobroker.sony-bravia",
  "version": "1.1.0",
  "description": "ioBroker Sony Bravia Smart-TV Adapter",
  "author": "ldittmar <iobroker@lmdsoft.de>",
  "contributors": [
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.sony-bravia",
  "license": "MIT",
  "keywords": [
    "sony",
    "bravia",
    "smart-tv"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.sony-bravia"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.20.0",
    "node-ssdp": "^4.0.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/type-detector": "^6.2.0",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@types/node-ssdp": "^4.0.5",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build-backend": "tsc -p tsconfig.build.json",
    "build-admin": "tsx tasks.ts",
    "build": "npm run build-backend && npm run build-admin",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/packageFiles --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade",
    "0-clean": "tsx tasks.ts --0-clean",
    "1-npm": "tsx tasks.ts --1-npm",
    "2-build": "tsx tasks.ts --2-build",
    "3-copy": "tsx tasks.ts --3-copy"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.sony-bravia/issues"
  },
  "readmeFilename": "README.md"
}
